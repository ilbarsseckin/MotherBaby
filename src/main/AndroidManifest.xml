<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ilbarsseckinapp.mother">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.hardware.camera"></uses-feature>
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity android:name=".SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>
        </activity>

        <activity
            android:name=".AlarmMessagePushNotifcation"
            android:configChanges="orientation|keyboardHidden|screenSize"
            />
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"/>
        <activity
            android:name=".Options_PhotoAlbum"
            android:launchMode="singleTop"/>
        <activity
            android:name=".Options_KasilmaSayar"
            android:launchMode="singleTop"/>
        <activity
            android:name=".Options_TekmeSayar"
            android:launchMode="singleTop"/>
        <activity
            android:name=".Options_IhtiyacListesi"
            android:launchMode="singleTop"/>
        <activity
            android:name=".Options_DogumCantasi"
            android:launchMode="singleTop"/>
        <activity
            android:name=".Options"
            android:launchMode="singleTop"/>

        <activity
            android:name=".Options_KgFollow"
            android:launchMode="singleTop"/>
        <activity
        android:name=".Options_Settings"
        android:launchMode="singleTop"/>

        <activity
        android:name=".Options_MedicinaFollow"
        android:launchMode="singleTop"/>

        <activity
            android:name=".CreateUser"
            android:launchMode="singleTop"/>
        <activity
            android:name=".AlarmActivity"
            android:launchMode="singleTop"/>

        <service
            android:name=".AlarmService"
            android:enabled="true" />

        <receiver android:name=".AlarmReceiver" />
      <!--  <activity
            android:name=".AddActivity"
            android:screenOrientation="portrait" >
        </activity>-->


    </application>

</manifest>