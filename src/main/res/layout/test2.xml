<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="80dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.fangxu.allangleexpandablebutton.AllAngleExpandableButton
                android:id="@+id/button_expandable_0_360"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:aebAnimDurationMillis="175"
                app:aebButtonElevation="4dp"
                app:aebButtonGapDp="55dp"
                app:aebEndAngleDegree="360"
                app:aebIsSelectionMode="false"
                app:aebMainButtonSizeDp="45dp"
                app:aebRippleEffect="true"
                app:aebStartAngleDegree="0"
                app:aebSubButtonSizeDp="45dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="startAngle=0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="endAngle=360" />
        </LinearLayout>

    </RelativeLayout>

</LinearLayout>