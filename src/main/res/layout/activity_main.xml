<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <VideoView
        android:id="@+id/Main_videoView"
        android:layout_width="match_parent"
        android:layout_height="117dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/BabyDaytxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="143 günlük" />

                    <TextView
                        android:id="@+id/PregnancyDaytxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="20. hafta 3. gün" />

                    <TextView
                        android:id="@+id/BirthDaytxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Doğuma 137 gün kaldı" />

                    <TextView
                        android:id="@+id/Dimensionstxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="havuç büyüklüğünde" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:layout_gravity="center|fill"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/MyBabyBtn"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/button1"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        android:background="@drawable/custom_button_image"
                        android:text="@string/Baby"
                        android:textColor="@drawable/custom_button_text_color"
                        android:textSize="14dip"
                        android:textStyle="normal" />

                    <Button
                        android:id="@+id/MotherBtn"
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/button1"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center"
                        android:background="@drawable/custom_button_image_mother"
                        android:text="@string/Mother"
                        android:textColor="@drawable/custom_button_text_color"
                        android:textSize="14dip"
                        android:textStyle="normal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/MainInfoTxt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="sddas"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</LinearLayout>