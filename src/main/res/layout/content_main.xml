<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:CircleProgressView="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_main"
    tools:context=".Test">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <LinearLayout
                android:id="@+id/mainscreenlayout"
                android:layout_width="match_parent"
                android:layout_height="163dp"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/Black"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/gif"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_gravity="bottom"
                    android:src="@drawable/dortweekfetus"

                    />

                <VideoView
                    android:id="@+id/Main_videoView"
                    android:layout_width="wrap_content"
                    android:layout_height="163dp"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:textSize="20sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/layouticon"
                android:orientation="vertical"
                android:paddingLeft="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="15dp"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text="Bebeğiniz       "
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/BabyDaytxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:text="\u00201"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:text=" günlük "
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/tremisetxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:text="1."
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:text=" Trimesterde"
                        android:textSize="16dp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="15dp"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text="Gebeliğinizin   "
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/PregnancyDaytxt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text=""
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text="haftası "
                        android:textSize="16dp" />


                    <TextView
                        android:id="@+id/artikguntxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text=""
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text="günü"
                        android:textSize="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="15dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text="Doğuma          "
                        android:textSize="16dp" />

                    <TextView
                        android:id="@+id/BirthDaytxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:gravity="center"
                        android:text=""
                        android:textSize="16dp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:gravity="left"
                        android:text="\u0020gün kaldı"
                        android:textSize="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp">

                    <Space
                        android:layout_width="15dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/Dimensionstxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo"
                        android:text="havuç büyüklüğünde"
                        android:textSize="16dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:fontFamily="@font/baloo"
                        android:textColor="@color/AppColor"
                        android:text="Doğum" />

                    <at.grabner.circleprogress.CircleProgressView
                        android:id="@+id/circleViewgun"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        CircleProgressView:cpv_autoTextSize="true"
                        CircleProgressView:cpv_barColor="@color/AppColor"
                        CircleProgressView:cpv_barWidth="10dp"
                        CircleProgressView:cpv_innerContourSize="0dp"
                        CircleProgressView:cpv_maxValue="100"
                        CircleProgressView:cpv_outerContourSize="0dp"
                        CircleProgressView:cpv_rimColor="@color/Baby_Blue"
                        CircleProgressView:cpv_rimWidth="10dp"
                        CircleProgressView:cpv_seekMode="false"
                        CircleProgressView:cpv_showUnit="true"
                        CircleProgressView:cpv_spinColor="@color/black"
                        CircleProgressView:cpv_textColor="@color/AppColor"
                        CircleProgressView:cpv_textScale="1"
                        CircleProgressView:cpv_unit="%"
                        CircleProgressView:cpv_unitColor="@color/pink"
                        CircleProgressView:cpv_unitPosition="left_top"
                        CircleProgressView:cpv_unitScale="1"
                        CircleProgressView:cpv_value="50" />

                </LinearLayout>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/baloo"
                        android:textColor="@color/AppColor"
                        android:text="Sağlık Testleri" />

                    <at.grabner.circleprogress.CircleProgressView
                        android:id="@+id/circleViewtest"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        CircleProgressView:cpv_autoTextSize="true"
                        CircleProgressView:cpv_barColor="@color/AppColor"
                        CircleProgressView:cpv_barWidth="10dp"
                        CircleProgressView:cpv_innerContourSize="0dp"
                        CircleProgressView:cpv_maxValue="100"
                        CircleProgressView:cpv_outerContourSize="0dp"
                        CircleProgressView:cpv_rimColor="@color/Baby_Blue"
                        CircleProgressView:cpv_rimWidth="10dp"
                        CircleProgressView:cpv_seekMode="false"
                        CircleProgressView:cpv_showUnit="true"
                        CircleProgressView:cpv_spinColor="@color/black"
                        CircleProgressView:cpv_textColor="@color/AppColor"
                        CircleProgressView:cpv_textScale="1"
                        CircleProgressView:cpv_unit="%"
                        CircleProgressView:cpv_unitColor="@color/pink"
                        CircleProgressView:cpv_unitPosition="left_top"
                        CircleProgressView:cpv_unitScale="1"
                        CircleProgressView:cpv_value="50" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:fontFamily="@font/baloo"
                        android:textColor="@color/AppColor"
                        android:text="İhtiyaç Listesi" />

                    <at.grabner.circleprogress.CircleProgressView
                        android:id="@+id/circleViewihtiyac"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        CircleProgressView:cpv_autoTextSize="true"
                        CircleProgressView:cpv_barColor="@color/AppColor"
                        CircleProgressView:cpv_barWidth="10dp"
                        CircleProgressView:cpv_innerContourSize="0dp"
                        CircleProgressView:cpv_maxValue="100"
                        CircleProgressView:cpv_outerContourSize="0dp"
                        CircleProgressView:cpv_rimColor="@color/Baby_Blue"
                        CircleProgressView:cpv_rimWidth="10dp"
                        CircleProgressView:cpv_seekMode="false"
                        CircleProgressView:cpv_showUnit="true"
                        CircleProgressView:cpv_spinColor="@color/black"
                        CircleProgressView:cpv_textColor="@color/AppColor"
                        CircleProgressView:cpv_textScale="1"
                        CircleProgressView:cpv_unit="%"
                        CircleProgressView:cpv_unitColor="@color/pink"
                        CircleProgressView:cpv_unitPosition="left_top"
                        CircleProgressView:cpv_unitScale="1"
                        CircleProgressView:cpv_value="50" />

                </LinearLayout>

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/baloo"
                        android:textColor="@color/AppColor"
                        android:text="Doğum Çantası" />

                    <at.grabner.circleprogress.CircleProgressView
                        android:id="@+id/circleViewdogumcantasi"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        CircleProgressView:cpv_autoTextSize="true"
                        CircleProgressView:cpv_barColor="@color/AppColor"
                        CircleProgressView:cpv_barWidth="10dp"
                        CircleProgressView:cpv_innerContourSize="0dp"
                        CircleProgressView:cpv_maxValue="100"
                        CircleProgressView:cpv_outerContourSize="0dp"
                        CircleProgressView:cpv_rimColor="@color/Baby_Blue"
                        CircleProgressView:cpv_rimWidth="10dp"
                        CircleProgressView:cpv_seekMode="false"
                        CircleProgressView:cpv_showUnit="true"
                        CircleProgressView:cpv_spinColor="@color/black"
                        CircleProgressView:cpv_textColor="@color/AppColor"
                        CircleProgressView:cpv_textScale="1"
                        CircleProgressView:cpv_unit="%"
                        CircleProgressView:cpv_unitColor="@color/pink"
                        CircleProgressView:cpv_unitPosition="left_top"
                        CircleProgressView:cpv_unitScale="1"
                        CircleProgressView:cpv_value="50" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/baloo"
                android:textColor="@color/AppColor"
                android:text="Kg" />

            <com.jjoe64.graphview.GraphView
                android:id="@+id/graph"
                android:layout_width="match_parent"
                android:layout_height="200dip" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="90dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
